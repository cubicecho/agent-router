{
  "name": "@cubicecho/agent-router",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "ai-router's agent half as a server package: agents, revisions, runs, the agent loop and workers. A host mounts it.",
  "type": "module",
  "exports": {
    ".": "./server/agent-router.ts",
    "./worker": "./worker/lib.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "worker": "node worker/index.ts",
    "build:worker": "node scripts/build-worker.ts",
    "pack:worker": "npm run build:worker && npm pack ./dist-worker",
    "codegen": "echo nothing to generate yet",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@casl/ability": "7.1.3",
    "@cubicecho/agent-core": "^7.4.0",
    "@escape.tech/graphql-armor-max-aliases": "2.6.2",
    "@escape.tech/graphql-armor-max-depth": "2.4.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vantreeseba/drizzle-graphql": "19.0.0",
    "@vantreeseba/graphql-casl": "1.11.0",
    "drizzle-orm": "1.0.0-rc.5",
    "eventsource-parser": "^3.1.1",
    "express": "^5.3.0",
    "graphql": "^16.13.2",
    "graphql-middleware": "6.1.35",
    "graphql-query-complexity": "2.0.0",
    "graphql-scalars": "2.0.1",
    "graphql-yoga": "5.24.6",
    "pg": "8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.5.17",
    "@graphql-tools/stitch": "11.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "rolldown": "^1.2.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
