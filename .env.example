# Required. A postgres:// URL. `npm run db:up` starts one on 127.0.0.1:5441; docker-compose.yml sets its own.
DATABASE_URL=postgres://agents:agents@127.0.0.1:5441/agents

# OpenAI-compatible providers, as a JSON list. An agent names its model as <provider>/<model>. Default: none, so no
# agent can run. apiKey is optional, and is sent only to its own provider.
# AGENT_ROUTER_PROVIDERS=[{"name":"ollama","baseUrl":"http://ollama.lan:11434/v1"}]

# A token that is the admin on /graphql, sent as `Authorization: Bearer`. Default: none.
# AGENT_ROUTER_ADMIN_TOKEN=

# 1: every /graphql request that presents no key is the admin. Default off. Unsafe anywhere but a private network.
# Without it or AGENT_ROUTER_ADMIN_TOKEN, nobody can use /graphql.
# SECURE_LOCAL_NET=1

# Where it listens, on every interface. Default 3100.
# PORT=3100

# production turns GraphiQL and introspection off. The image sets it.
# NODE_ENV=production

# The image docker-compose.yml runs. Default ghcr.io/cubicecho/agent-router:latest.
# AGENT_ROUTER_IMAGE=

# docker-compose.yml's Postgres password. Default agents.
# POSTGRES_PASSWORD=
